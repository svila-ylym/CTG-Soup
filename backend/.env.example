# Application
APP_NAME="汤吧社区"
APP_VERSION="1.0.0"
DEBUG=true
APP_URL=http://localhost:10000
# Public browser URL used in email links. Falls back to APP_URL when empty.
PUBLIC_WEB_URL=
SIGNIN_TIMEZONE=Asia/Shanghai

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/turtle_soup
AUTO_CREATE_DATABASE=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis and Elasticsearch
REDIS_URL=redis://localhost:6379/0
ELASTICSEARCH_URL=http://localhost:9200

# JWT: replace this value in every local or deployed environment
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# SMTP (optional). Port 465 normally requires SMTP_USE_SSL=true.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
VERIFICATION_CODE_EXPIRE_MINUTES=30
EMAIL_DOMAIN_WHITELIST=[]
EMAIL_VERIFICATION_IP_LIMIT=5
EMAIL_VERIFICATION_EMAIL_LIMIT=3
EMAIL_VERIFICATION_GLOBAL_LIMIT=100
EMAIL_VERIFICATION_IP_WINDOW_SECONDS=60
EMAIL_VERIFICATION_EMAIL_WINDOW_SECONDS=3600
EMAIL_VERIFICATION_GLOBAL_WINDOW_SECONDS=60
SMTP_VERIFICATION_RETRY_ATTEMPTS=3

# Local file storage.
LOCAL_STORAGE_DIR=storage
PRIVATE_STORAGE_DIR=private-storage
MAX_UPLOAD_BYTES=5242880

# Pagination and ranking
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
BAYESIAN_C=3.0
BAYESIAN_M=5.0
