# Application
APP_NAME="汤吧社区"
# The runtime version is read from the repository VERSION file.
# APP_VERSION_OVERRIDE="1.2.0"
DEBUG=true
APP_URL=http://localhost:10000
# Public browser URL used in email links. Falls back to APP_URL when empty.
PUBLIC_WEB_URL=
SIGNIN_TIMEZONE=Asia/Shanghai

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/turtle_soup
# Optional matching PostgreSQL client for OTA backups. BaoTa uses:
# PG_DUMP_BIN=/www/server/pgsql/bin/pg_dump
PG_DUMP_BIN=
AUTO_CREATE_DATABASE=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis and Elasticsearch
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_ENABLED=true
REDIS_CACHE_DEFAULT_TTL=300
ELASTICSEARCH_URL=http://localhost:9200

# JWT: replace this value in every local or deployed environment
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# SMTP (optional). Port 465 normally requires SMTP_USE_SSL=true.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
VERIFICATION_CODE_EXPIRE_MINUTES=30
EMAIL_DOMAIN_WHITELIST=[]
EMAIL_VERIFICATION_IP_LIMIT=5
EMAIL_VERIFICATION_EMAIL_LIMIT=3
EMAIL_VERIFICATION_GLOBAL_LIMIT=100
EMAIL_VERIFICATION_IP_WINDOW_SECONDS=60
EMAIL_VERIFICATION_EMAIL_WINDOW_SECONDS=3600
EMAIL_VERIFICATION_GLOBAL_WINDOW_SECONDS=60
SMTP_VERIFICATION_RETRY_ATTEMPTS=3

# File storage. Keep real R2 credentials only in the untracked .env file.
LOCAL_STORAGE_DIR=storage
PRIVATE_STORAGE_DIR=private-storage
MAX_UPLOAD_BYTES=5242880

# OTA updates. A token is optional for this public repository.
# OTA_UPDATE_MODE: "Latest" accepts only semantic versions (1.4.1), "Dev" accepts only tag versions (24w52c)
GITHUB_REPOSITORY=svila-ylym/CTG-Soup
GITHUB_API_URL=https://api.github.com
GITHUB_API_TOKEN=
GITHUB_RELEASE_CACHE_SECONDS=300
GITHUB_API_TIMEOUT_SECONDS=10
OTA_UPDATE_MODE=Latest
UPDATE_REPOSITORY_PATH=
UPDATE_SCRIPT_PATH=
UPDATE_LOG_DIR=private-storage/update-logs
# Must invoke a detached helper that does not terminate the OTA updater itself.
# For Screen, use a separate session/control command; for systemd use systemd-run --no-block.
UPDATE_RESTART_COMMAND=
# Health URL checked after restart; the response version must match the release tag.
UPDATE_HEALTH_URL=http://127.0.0.1:10001/health
PUBLIC_STORAGE_BACKEND=local
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=your-bucket-name
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=https://assets.example.com

# Pagination and ranking
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
